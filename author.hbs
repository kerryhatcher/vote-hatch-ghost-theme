{{!< default}}

<header class="author-header">
    {{#author}}
    {{#if profile_image}}
    <img class="author-profile-image" src="{{profile_image}}" alt="{{name}}">
    {{/if}}
    <h1 class="author-title">{{name}}</h1>
    {{#if bio}}
    <p class="author-bio">{{bio}}</p>
    {{/if}}
    {{/author}}
</header>

<div class="post-feed">
    {{#foreach posts}}
        {{> "list-post"}}
    {{/foreach}}
</div>

{{pagination}}
