{{!< default}}

<header class="author-header">
    {{#author}}
    {{#if profile_image}}
    <img class="author-profile-image"
         src="{{img_url profile_image size="m"}}"
         alt="{{name}}">
    {{/if}}
    <h1 class="author-title">{{name}}</h1>
    {{#if bio}}
    <p class="author-bio">{{bio}}</p>
    {{/if}}
    <div class="author-social-links">
        {{#if website}}
        <a href="{{website}}" class="social-link" aria-label="Website" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
        </a>
        {{/if}}
        {{#if twitter}}
        <a href="https://twitter.com/{{twitter}}" class="social-link" aria-label="Twitter" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        {{/if}}
        {{#if facebook}}
        <a href="https://facebook.com/{{facebook}}" class="social-link" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        {{/if}}
    </div>
    {{/author}}
</header>

<div class="author-feed container">
    <div class="post-feed">
        {{#foreach posts}}
            {{> "list-post"}}
        {{/foreach}}
    </div>

    {{pagination}}
</div>
