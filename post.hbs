{{!< default}}

{{#post}}
<article class="single-post {{post_class}}">
    <header class="post-header">
        <h1 class="post-title">{{title}}</h1>
        <div class="post-meta">
            <time class="post-date" datetime="{{date format="YYYY-MM-DD"}}">
                {{date format="DD MMMM YYYY"}}
            </time>
            {{#primary_author}}
            <span class="post-author">by <a href="{{url}}">{{name}}</a></span>
            {{/primary_author}}
            {{#primary_tag}}
            <span class="post-tag-meta"><a href="{{url}}">{{name}}</a></span>
            {{/primary_tag}}
        </div>
    </header>

    {{#if feature_image}}
    <figure class="post-feature-image">
        <img srcset="{{img_url feature_image size="m"}} 600w,
                     {{img_url feature_image size="l"}} 1000w,
                     {{img_url feature_image size="xl"}} 2000w"
             sizes="(max-width: 740px) 100vw, 740px"
             src="{{img_url feature_image size="l"}}"
             alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
        {{#if feature_image_caption}}
        <figcaption>{{feature_image_caption}}</figcaption>
        {{/if}}
    </figure>
    {{/if}}

    <section class="post-content">
        {{content}}
    </section>

    {{> social-share}}

    <footer class="post-footer">
        {{#if tags}}
        <div class="post-tags">
            {{#foreach tags}}
            <a href="{{url}}" class="post-tag">{{name}}</a>
            {{/foreach}}
        </div>
        {{/if}}
    </footer>
</article>
{{/post}}
