<div class="newsletter-signup">
    <form class="newsletter-form" data-members-form="subscribe">
        <input class="newsletter-input" type="email" required placeholder="Your email address" aria-label="Email address" data-members-email>
        <button class="newsletter-btn btn" type="submit">Subscribe</button>
    </form>
    <p class="newsletter-message success" data-members-success style="display:none">Check your inbox for a confirmation email!</p>
    <p class="newsletter-message error" data-members-error style="display:none"></p>
</div>
