<header class="site-header" role="banner">
    <div class="header-inner container">
        <div class="header-brand">
            {{#if @site.logo}}
            <a href="{{@site.url}}" class="header-logo" aria-label="{{@site.title}} - Home">
                <img src="{{@site.logo}}" alt="{{@site.title}}">
            </a>
            {{else}}
            <a href="{{@site.url}}" class="header-title" aria-label="{{@site.title}} - Home">
                {{@site.title}}
            </a>
            {{/if}}
        </div>

        <nav class="header-nav" role="navigation" aria-label="Main navigation">
            {{navigation}}
        </nav>

        <a href="{{@custom.donate_url}}" class="btn btn-accent header-cta">Chip In</a>

        <button class="mobile-menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
        </button>
    </div>

    <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
        <nav class="mobile-nav" role="navigation" aria-label="Mobile navigation">
            {{navigation}}
        </nav>
        <a href="{{@custom.donate_url}}" class="btn btn-accent mobile-cta">Chip In</a>
    </div>
</header>
