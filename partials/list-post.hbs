<article class="{{post_class}}">
    {{#if feature_image}}
    <a href="{{url}}" class="post-card-image-link">
        <img class="post-card-image" src="{{feature_image}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
    </a>
    {{/if}}
    <div class="post-card-content">
        <header class="post-card-header">
            {{#primary_tag}}
            <span class="post-card-primary-tag"><a href="{{url}}">{{name}}</a></span>
            {{/primary_tag}}
            <h2 class="post-card-title">
                <a href="{{url}}">{{title}}</a>
            </h2>
        </header>
        {{#if excerpt}}
        <div class="post-card-excerpt">
            <p>{{excerpt}}</p>
        </div>
        {{/if}}
        <footer class="post-card-meta">
            <time class="post-card-date" datetime="{{date format="YYYY-MM-DD"}}">
                {{date format="DD MMMM YYYY"}}
            </time>
            {{#primary_author}}
            <span class="post-card-author">
                {{#if profile_image}}
                <img class="author-thumb" src="{{profile_image}}" alt="{{name}}">
                {{/if}}
                <a href="{{url}}">{{name}}</a>
            </span>
            {{/primary_author}}
        </footer>
    </div>
</article>
