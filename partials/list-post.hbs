<article class="post-card {{post_class}} reveal">
    {{#if feature_image}}
    <a href="{{url}}" class="post-card-image-link" aria-hidden="true" tabindex="-1">
        <img class="post-card-image"
            srcset="{{img_url feature_image size="s"}} 300w,
                    {{img_url feature_image size="m"}} 600w,
                    {{img_url feature_image size="l"}} 1000w"
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
            src="{{img_url feature_image size="m"}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            loading="lazy">
    </a>
    {{/if}}
    <div class="post-card-content">
        <header class="post-card-header">
            {{#primary_tag}}
            <span class="post-card-primary-tag"><a href="{{url}}">{{name}}</a></span>
            {{/primary_tag}}
            <h2 class="post-card-title">
                <a href="{{url}}">{{title}}</a>
            </h2>
        </header>
        {{#if excerpt}}
        <div class="post-card-excerpt">
            <p>{{excerpt}}</p>
        </div>
        {{/if}}
        <footer class="post-card-meta">
            <time class="post-card-date" datetime="{{date format="YYYY-MM-DD"}}">
                {{date format="DD MMMM YYYY"}}
            </time>
            {{#primary_author}}
            <span class="post-card-author">
                {{#if profile_image}}
                <img class="author-thumb" src="{{img_url profile_image size="xs"}}" alt="{{name}}" loading="lazy">
                {{/if}}
                <a href="{{url}}">{{name}}</a>
            </span>
            {{/primary_author}}
        </footer>
    </div>
</article>
