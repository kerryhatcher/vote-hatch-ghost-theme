{
    "name": "vote-hatch-ghost-theme",
    "description": "A custom Ghost theme for the VoteHatcher campaign website",
    "version": "2.0.0",
    "license": "MIT",
    "keywords": ["ghost-theme"],
    "author": {
        "email": "kerryhatcher@users.noreply.github.com"
    },
    "config": {
        "posts_per_page": 9,
        "image_sizes": {
            "xxs": { "width": 30 },
            "xs": { "width": 100 },
            "s": { "width": 300 },
            "m": { "width": 600 },
            "l": { "width": 1000 },
            "xl": { "width": 2000 }
        },
        "card_assets": true,
        "custom": {
            "hero_heading": {
                "type": "text",
                "default": "Fighting for Our Community"
            },
            "hero_subheading": {
                "type": "text",
                "default": "Join the movement to build a brighter future for everyone."
            },
            "donate_url": {
                "type": "text",
                "default": "/chip-in/"
            },
            "volunteer_url": {
                "type": "text",
                "default": "/join/"
            },
            "platform_url": {
                "type": "text",
                "default": "/my-platform/"
            },
            "campaign_disclaimer": {
                "type": "text",
                "default": "Paid for by the Committee to Elect Kerry Hatcher"
            },
            "facebook_url": {
                "type": "text"
            },
            "twitter_url": {
                "type": "text"
            },
            "instagram_url": {
                "type": "text"
            },
            "youtube_url": {
                "type": "text"
            },
            "about_image": {
                "type": "image"
            },
            "show_cta_bar": {
                "type": "boolean",
                "default": true
            }
        }
    },
    "custom": {
        "full-width": {
            "post": false,
            "page": ["custom-full-width"]
        }
    }
}
